---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FacilityHero from '../components/FacilityHero.astro';
import QuickFacts from '../components/QuickFacts.astro';
import StateVisitingRules from '../components/StateVisitingRules.astro';
import PlanYourVisit from '../components/PlanYourVisit.astro';
import Sources from '../components/Sources.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { createBreadcrumbStructuredData, createFacilityStructuredData } from '../lib/seo';
import { genericSourceLabels, systemSourceLabels } from '../data/system-source-labels';
import { t } from '../lib/ui-strings';

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

const {
  facility,
  stateTitle,
  headings = [],
  lang = 'en',
  hasSpanish = false
} = Astro.props as {
  facility: CollectionEntry<'facilities'>;
  stateTitle: string;
  headings?: Heading[];
  lang?: 'en' | 'es';
  hasSpanish?: boolean;
};

const sdPrefix = lang === 'es' ? '/es' : '';
const breadcrumbItems = [
  { label: t(lang, 'crumb.home'), href: `${sdPrefix}/` },
  { label: t(lang, 'crumb.states'), href: `${sdPrefix}/states/` },
  { label: stateTitle, href: `${sdPrefix}/states/${Astro.params.state}/` },
  { label: t(lang, 'crumb.facilities'), href: `${sdPrefix}/states/${Astro.params.state}/#facilities` },
  { label: facility.data.title, href: Astro.url.pathname }
];

// Assemble the Sources list: the official facility page and inmate locator are
// already in `links` (but rendered nowhere else), so surface them here, labeled
// by corrections system, alongside any frontmatter `sources` (e.g. the statewide
// visitation rulebook). Order: facility page → policy source(s) → locator.
const links = facility.data.links ?? {};
const labels = systemSourceLabels[facility.data.system] ?? genericSourceLabels;
const officialLabel = labels.official;
const locatorLabel = labels.locator;
const facilitySources = [
  links.official ? { name: officialLabel, url: links.official } : null,
  ...(facility.data.sources ?? []),
  links.inmateLocator ? { name: locatorLabel, url: links.inmateLocator } : null
].filter((entry): entry is { name: string; url: string } => Boolean(entry));

// Search-result meta description. The `summary` describes what the prison IS,
// which reads well on the page but buries the words families search for. Lead
// the <meta description> with the practical intent — visiting hours, rules,
// mailing address, phone — plus the unique facility name, system, and location,
// so the Google snippet answers the query. The visible on-page summary
// (rendered below) is unchanged.
const metaLoc = facility.data.city ? `${facility.data.city}, ${stateTitle}` : stateTitle;
const metaDescription =
  lang === 'es'
    ? `Visitas en ${facility.data.title}: horarios, reglas para visitantes, dirección postal y teléfono del centro ${facility.data.system} en ${metaLoc}.`
    : `Visiting ${facility.data.title}: hours, approved-visitor rules, mailing address, and phone for the ${facility.data.system} facility in ${metaLoc}.`;
---

<BaseLayout
  title={facility.data.title}
  seoTitle={lang === 'es' ? `${facility.data.title} — Visitas, correo y teléfono` : `${facility.data.title} Visiting Hours, Mail & Phone`}
  description={metaDescription}
  lang={lang}
  hasSpanish={hasSpanish}
  structuredData={[
    createBreadcrumbStructuredData(breadcrumbItems),
    createFacilityStructuredData({
      name: facility.data.title,
      url: Astro.url.pathname,
      description: facility.data.summary,
      address: facility.data.address,
      telephone: facility.data.contact.mainPhone,
      latitude: facility.data.coordinates?.latitude,
      longitude: facility.data.coordinates?.longitude
    })
  ]}
>
  <div class="container guide-grid">
    <article class="guide-content content-width">
      <Breadcrumbs pageTitle={facility.data.title} stateLabel={stateTitle} lang={lang} />
      <FacilityHero facility={facility.data} stateTitle={stateTitle} />
      {facility.data.summary && <p class="facility-page-summary subtitle">{facility.data.summary}</p>}
      <PlanYourVisit facility={facility} stateSlug={Astro.params.state} lang={lang} />
      <StateVisitingRules state={facility.data.state} facilitySystem={facility.data.system} lang={lang} />
      <slot />
      <Sources sources={facilitySources} lang={lang} />
    </article>

    <div class="guide-sidebar">
      <QuickFacts
        facility={facility}
        stateTitle={stateTitle}
        phone={facility.data.contact.visitingOffice ?? facility.data.contact.mainPhone}
        directionsUrl={facility.data.address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(facility.data.address)}` : undefined}
        lang={lang}
      />
      <TableOfContents headings={headings} lang={lang} />
    </div>
  </div>
</BaseLayout>
