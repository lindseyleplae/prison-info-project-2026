---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Feedback from '../components/Feedback.astro';
import DisclaimerBar from '../components/DisclaimerBar.astro';
import { buildSeo, createWebsiteStructuredData, altLangPaths, toAbsoluteUrl, type StructuredData } from '../lib/seo';
import { t } from '../lib/ui-strings';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/print.css';

const {
  title,
  seoTitle,
  description,
  image,
  noindex = false,
  structuredData = [],
  lang = 'en',
  hasSpanish = false
} = Astro.props as {
  title?: string;
  seoTitle?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  structuredData?: StructuredData[];
  lang?: 'en' | 'es';
  hasSpanish?: boolean;
};

const { enPath, esPath } = altLangPaths(Astro.url.pathname);

const seo = buildSeo({
  title,
  seoTitle,
  description,
  image,
  noindex,
  canonicalPath: Astro.url.pathname,
  structuredData: [createWebsiteStructuredData(), ...structuredData]
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="2XsxQQXdavmtRsZZYmNVhK409IDu-cRQS0yc3QkrmWE" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#FAF9F3" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    {hasSpanish && (
      <>
        <link rel="alternate" hreflang="en" href={toAbsoluteUrl(enPath)} />
        <link rel="alternate" hreflang="es" href={toAbsoluteUrl(esPath)} />
        <link rel="alternate" hreflang="x-default" href={toAbsoluteUrl(enPath)} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    {seo.image && <meta property="og:image" content={seo.image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}
    {seo.structuredData.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === 'es' ? t('es', 'skip.toContent') : 'Skip to content'}</a>
    <div id="offline-banner" class="offline-banner" role="status" hidden>{t(lang, 'offline.notice')}</div>
    <div class="site-shell">
      <DisclaimerBar lang={lang} />
      <Header lang={lang} enPath={enPath} esPath={esPath} hasSpanish={hasSpanish} />
      <main id="main-content" class="site-main">
        <slot />
      </main>
      <Feedback lang={lang} />
      <Footer lang={lang} />
    </div>
    {/* Anonymous, cookie-free visit counting (GoatCounter): page URL, referrer,
        browser type, and country only — no cookies, no personal identifiers,
        no cross-site tracking. Disclosed on the privacy page. Production only;
        GoatCounter additionally ignores localhost. */}
    {import.meta.env.PROD && (
      <script
        is:inline
        data-goatcounter="https://prisonvisitorguide.goatcounter.com/count"
        async
        src="https://gc.zgo.at/count.js"
      />
    )}
    {/* Register the service worker (offline support) in production only — it
        conflicts with the dev server's live reload. */}
    {import.meta.env.PROD && (
      <script is:inline set:html={"if('serviceWorker' in navigator){window.addEventListener('load',function(){navigator.serviceWorker.register('/sw.js').catch(function(){});});}"} />
    )}
    {/* Show the "saved copy" banner whenever the browser reports it is offline. */}
    <script is:inline set:html={"(function(){var b=document.getElementById('offline-banner');if(!b)return;function u(){b.hidden=navigator.onLine;}window.addEventListener('online',u);window.addEventListener('offline',u);u();})();"} />
  </body>
</html>
