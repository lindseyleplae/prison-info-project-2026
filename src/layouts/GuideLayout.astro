---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Sources from '../components/Sources.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RelatedGuideNote from '../components/RelatedGuideNote.astro';
import { createBreadcrumbStructuredData } from '../lib/seo';
import { t } from '../lib/ui-strings';

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Source = { name: string; url?: string };
type RelatedGuide = { title: string; href: string };

const {
  title,
  description,
  headings = [],
  stateLabel,
  lastReviewed,
  sources = [],
  relatedNationalGuide,
  lang = 'en',
  hasSpanish = false
} = Astro.props as {
  title: string;
  description?: string;
  headings?: Heading[];
  stateLabel?: string;
  lastReviewed?: Date;
  sources?: Source[];
  relatedNationalGuide?: RelatedGuide;
  lang?: 'en' | 'es';
  hasSpanish?: boolean;
};

// Structured-data breadcrumb trail (JSON-LD, not the visible crumbs). Labels
// and intermediate hrefs follow the page language so the /es pages describe the
// Spanish trail; English keeps the original labels and bare hrefs unchanged.
const sdPrefix = lang === 'es' ? '/es' : '';
const breadcrumbItems = [
  { label: t(lang, 'crumb.home'), href: `${sdPrefix}/` },
  ...(stateLabel
    ? [
        { label: t(lang, 'crumb.states'), href: `${sdPrefix}/states/` },
        { label: stateLabel, href: Astro.params.state ? `${sdPrefix}/states/${Astro.params.state}/` : undefined }
      ]
    : [{ label: t(lang, 'crumb.guides'), href: `${sdPrefix}/guides/` }]),
  { label: title, href: Astro.url.pathname }
];
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  hasSpanish={hasSpanish}
  structuredData={[createBreadcrumbStructuredData(breadcrumbItems)]}
>
  <div class="container guide-grid">
    <article class="guide-content content-width">
      <Breadcrumbs pageTitle={title} stateLabel={stateLabel} lang={lang} />
      <header class="page-header">
        <h1>{title}</h1>
        {description && <p class="subtitle">{description}</p>}
        {lastReviewed && <p class="meta">{lang === 'es' ? t('es', 'guide.lastReviewed') : 'Last reviewed:'} {lastReviewed.toISOString().slice(0, 10)}</p>}
      </header>
      <slot />
      {relatedNationalGuide && <RelatedGuideNote guide={relatedNationalGuide} lang={lang} />}
      <Sources sources={sources} lang={lang} />
    </article>

    <div class="guide-sidebar">
      <TableOfContents headings={headings} lang={lang} />
    </div>
  </div>
</BaseLayout>
