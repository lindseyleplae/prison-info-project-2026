---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../../../../layouts/GuideLayout.astro';

export async function getStaticPaths() {
  const [states, guides, nationalGuides] = await Promise.all([
    getCollection('states', ({ data }) => !data.draft && data.lang === 'es'),
    getCollection('state-guides', ({ data }) => !data.draft && data.lang === 'es'),
    getCollection('national-guides', ({ data }) => !data.draft && data.lang === 'es')
  ]);

  const stateByCode = new Map(states.map((entry) => [entry.data.state, entry]));
  const nationalGuideBySlug = new Map(nationalGuides.map((guide) => [guide.data.slug, guide]));

  return guides
    .map((entry) => {
      const state = stateByCode.get(entry.data.state);
      if (!state) {
        return undefined;
      }

      const national = entry.data.relatedNationalGuide
        ? nationalGuideBySlug.get(entry.data.relatedNationalGuide)
        : undefined;

      return {
        params: {
          state: state.data.slug,
          slug: entry.data.topic ?? entry.data.slug
        },
        props: {
          entry,
          stateTitle: state.data.title,
          relatedNationalGuide: national
            ? { title: national.data.title, href: `/es/guides/${national.data.slug}/` }
            : undefined
        }
      };
    })
    .filter(Boolean);
}

const { entry, stateTitle, relatedNationalGuide } = Astro.props;
const { Content, headings } = await render(entry);

// Spanish search titles mirror the English ones: lead with the topic wording
// families search for, plus the state. Terminology follows the ES content
// ("recluso"), and the visible h1 keeps the shorter editorial title.
const guideSeoTitles: Record<string, (state: string, system: string) => string> = {
  visiting: (state, system) => `Visitas en prisiones de ${state} — reglas y horarios (${system})`,
  mail: (state, system) => `Correo y paquetes a prisiones de ${state} (${system})`,
  'phone-video': (state, system) => `Llamadas y videollamadas en prisiones de ${state} (${system})`,
  money: (state, system) => `Cómo enviar dinero a un recluso en ${state} (${system})`,
  medical: (state, system) => `Atención médica y salud mental en prisiones de ${state} (${system})`,
  transfers: (state, system) => `Buscar a una persona y traslados en ${state} (${system})`
};
const guideTopic = entry.data.topic ?? entry.data.slug;
const guideSystem = entry.data.system;
const seoTitle = guideSystem && guideSeoTitles[guideTopic]
  ? guideSeoTitles[guideTopic](stateTitle, guideSystem)
  : undefined;
---

<GuideLayout
  title={entry.data.title}
  seoTitle={seoTitle}
  description={entry.data.description ?? entry.data.summary}
  headings={headings}
  stateLabel={stateTitle}
  lastReviewed={entry.data.lastReviewed}
  sources={entry.data.sources}
  relatedNationalGuide={relatedNationalGuide}
  lang="es"
  hasSpanish={true}
>
  <Content />
</GuideLayout>
