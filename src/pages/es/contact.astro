---
import { getEntry, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const entry = await getEntry('pages', 'es/contact');
if (!entry) throw new Error('Missing pages/es/contact.md');
const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} description={entry.data.description ?? entry.data.summary} lang="es" hasSpanish={true}>
  <Content />
</PageLayout>
