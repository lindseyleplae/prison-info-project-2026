---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';

export async function getStaticPaths() {
  const [enEntries, esEntries] = await Promise.all([
    getCollection('national-guides', ({ data }) => !data.draft && data.lang === 'en'),
    getCollection('national-guides', ({ data }) => !data.draft && data.lang === 'es')
  ]);
  const spanishSlugs = new Set(esEntries.map((e) => e.data.slug));

  return enEntries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry, hasSpanish: spanishSlugs.has(entry.data.slug) }
  }));
}

const { entry, hasSpanish } = Astro.props;
const { Content, headings } = await render(entry);
---

<GuideLayout
  title={entry.data.title}
  description={entry.data.description ?? entry.data.summary}
  headings={headings}
  lastReviewed={entry.data.lastReviewed}
  sources={entry.data.sources}
  hasSpanish={hasSpanish}
>
  <Content />
</GuideLayout>
