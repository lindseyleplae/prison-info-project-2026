---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../../../layouts/GuideLayout.astro';

export async function getStaticPaths() {
  const [states, guides, nationalGuides, esGuides] = await Promise.all([
    getCollection('states', ({ data }) => !data.draft && data.lang === 'en'),
    getCollection('state-guides', ({ data }) => !data.draft && data.lang === 'en'),
    getCollection('national-guides', ({ data }) => !data.draft && data.lang === 'en'),
    getCollection('state-guides', ({ data }) => !data.draft && data.lang === 'es')
  ]);

  const stateByCode = new Map(states.map((entry) => [entry.data.state, entry]));
  const nationalGuideBySlug = new Map(nationalGuides.map((guide) => [guide.data.slug, guide]));
  const spanishGuideKeys = new Set(esGuides.map((guide) => `${guide.data.state}:${guide.data.topic ?? guide.data.slug}`));

  return guides
    .map((entry) => {
      const state = stateByCode.get(entry.data.state);
      if (!state) {
        return undefined;
      }

      const national = entry.data.relatedNationalGuide
        ? nationalGuideBySlug.get(entry.data.relatedNationalGuide)
        : undefined;

      return {
        params: {
          state: state.data.slug,
          slug: entry.data.topic ?? entry.data.slug
        },
        props: {
          entry,
          stateTitle: state.data.title,
          relatedNationalGuide: national
            ? { title: national.data.title, href: `/guides/${national.data.slug}/` }
            : undefined,
          hasSpanish: spanishGuideKeys.has(`${entry.data.state}:${entry.data.topic ?? entry.data.slug}`)
        }
      };
    })
    .filter(Boolean);
}

const { entry, stateTitle, relatedNationalGuide, hasSpanish } = Astro.props;
const { Content, headings } = await render(entry);

// Search titles lead with the state and the phrasing families actually type
// ("arizona prison visiting rules", "sending money to an inmate in ohio").
// The visible h1 keeps the shorter editorial title. Any guide missing a topic
// mapping or a system code falls back to that title.
const guideSeoTitles: Record<string, (state: string, system: string) => string> = {
  visiting: (state, system) => `${state} Prison Visiting Rules & Hours (${system})`,
  mail: (state, system) => `${state} Prison Mail Rules & Mailing Address (${system})`,
  'phone-video': (state, system) => `${state} Prison Phone Calls & Video Visits (${system})`,
  money: (state, system) => `Sending Money to an Inmate in ${state} (${system})`,
  medical: (state, system) => `${state} Prison Medical & Mental Health Care (${system})`,
  transfers: (state, system) => `${state} Inmate Search & Prison Transfers (${system})`
};
const guideTopic = entry.data.topic ?? entry.data.slug;
const guideSystem = entry.data.system;
const seoTitle = guideSystem && guideSeoTitles[guideTopic]
  ? guideSeoTitles[guideTopic](stateTitle, guideSystem)
  : undefined;
---

<GuideLayout
  title={entry.data.title}
  seoTitle={seoTitle}
  description={entry.data.description ?? entry.data.summary}
  headings={headings}
  stateLabel={stateTitle}
  lastReviewed={entry.data.lastReviewed}
  sources={entry.data.sources}
  relatedNationalGuide={relatedNationalGuide}
  hasSpanish={hasSpanish}
>
  <Content />
</GuideLayout>
