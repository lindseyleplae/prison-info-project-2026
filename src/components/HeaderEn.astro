---
// English site header. This is the original Header markup, kept at the top
// level of its own component so Astro preserves its exact inter-tag whitespace
// — rendering byte-for-byte as before. Header.astro dispatches to this for
// English pages and to HeaderEs.astro for Spanish. The shared menu <script>
// lives once in Header.astro, so it is intentionally absent here.
import { getCollection } from 'astro:content';
import { siteConfig, siteNavigation } from '../data/site';
import BrandMark from './BrandMark.astro';

const { enPath = '/', esPath = '/es/', hasSpanish = false } = Astro.props as {
  enPath?: string;
  esPath?: string;
  hasSpanish?: boolean;
};

const guides = await getCollection('national-guides', ({ data }) => !data.draft && data.lang === 'en');

guides.sort((left, right) => (left.data.order ?? 999) - (right.data.order ?? 999) || left.data.title.localeCompare(right.data.title));
---

<header class="site-header">
  <div class="header-inner">
    <a class="site-title" href="/">
      <BrandMark class="site-title__mark" />
      <span class="site-title__name">{siteConfig.name}</span>
    </a>

    <button type="button" class="mobile-menu-toggle" aria-expanded="false" aria-controls="primary-nav">
      Menu
    </button>

    <nav id="primary-nav" class="site-nav" aria-label="Primary">
      <div class="nav-group" data-nav-group>
        <div class="nav-group__trigger">
          <a class="nav-link" href="/guides/">National Guides</a>
          <button
            type="button"
            class="nav-submenu-toggle"
            aria-expanded="false"
            aria-controls="nav-menu-guides"
            data-submenu-toggle
          >
            <span class="sr-only">Toggle National Guides submenu</span>
            <span aria-hidden="true">+</span>
          </button>
        </div>
        <div id="nav-menu-guides" class="nav-menu">
          <a href="/guides/" class="nav-menu__view-all">All national guides</a>
          {guides.map((guide) => (
            <a href={`/guides/${guide.data.slug}/`}>{guide.data.title}</a>
          ))}
        </div>
      </div>

      <a class="nav-link" href="/states/">States</a>

      {siteNavigation.staticLinks.map((link) => (
        <a class="nav-link" href={link.href}>
          {link.label}
        </a>
      ))}

      {hasSpanish && (
        <div class="lang-toggle" aria-label="Language / Idioma">
          <a class="nav-link" href={enPath} hreflang="en" aria-current="true">English</a>
          <span class="lang-toggle__sep" aria-hidden="true">·</span>
          <a class="nav-link" href={esPath} hreflang="es">Español</a>
        </div>
      )}
    </nav>
  </div>
</header>
