---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../lib/ui-strings';

const { facility, stateTitle, phone, directionsUrl, lang = 'en' } = Astro.props as {
  facility: CollectionEntry<'facilities'>;
  stateTitle: string;
  phone?: string;
  directionsUrl?: string;
  lang?: Lang;
};

const formatDate = (value: Date) =>
  new Intl.DateTimeFormat(lang === 'es' ? 'es-US' : 'en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC'
  }).format(value);

const phoneHref = phone?.replace(/[^\d+]/g, '');

const factGroups = [
  {
    label: t(lang, 'quickFacts.facilityDetails'),
    facts: [
      [t(lang, 'quickFacts.state'), stateTitle],
      [t(lang, 'quickFacts.system'), facility.data.system],
      [t(lang, 'quickFacts.type'), facility.data.facilityType],
      [t(lang, 'quickFacts.securityLevel'), facility.data.securityLevel]
    ]
  },
  {
    label: t(lang, 'quickFacts.location'),
    facts: [
      [t(lang, 'quickFacts.city'), facility.data.city],
      [t(lang, 'quickFacts.county'), facility.data.county],
      [t(lang, 'quickFacts.address'), facility.data.address]
    ]
  },
  {
    label: t(lang, 'quickFacts.contactVisiting'),
    facts: [
      [t(lang, 'quickFacts.mainPhone'), facility.data.contact.mainPhone],
      [t(lang, 'quickFacts.visitingHours'), facility.data.visiting?.hours],
      [t(lang, 'quickFacts.visitingDays'), facility.data.visiting?.days]
    ]
  },
  {
    label: t(lang, 'quickFacts.verification'),
    facts: [[t(lang, 'quickFacts.lastVerified'), formatDate(facility.data.lastVerified)]]
  }
]
  .map((group) => ({
    ...group,
    facts: group.facts.filter((entry): entry is [string, string] => Boolean(entry[1]))
  }))
  .filter((group) => group.facts.length > 0);
---

<aside class="quick-facts">
  <p class="key-info-label">{t(lang, 'quickFacts.label')}</p>
  {factGroups.map((group) => (
    <section class="quick-facts__group" aria-label={group.label}>
      <dl>
        {group.facts.map(([label, value]) => (
          <div class="quick-facts__item fact">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </section>
  ))}
  {(phone || directionsUrl) && (
    <div class="quick-facts__actions">
      {phone && (
        lang === 'es' ? (
          <a href={`tel:${phoneHref}`} class="btn btn--primary">{t('es', 'quickFacts.callToVerify')}</a>
        ) : (
          <a href={`tel:${phoneHref}`} class="btn btn--primary">
            Call to Verify
          </a>
        )
      )}
      {directionsUrl && (
        lang === 'es' ? (
          <a href={directionsUrl} class="btn btn--secondary" target="_blank" rel="noopener">{t('es', 'quickFacts.getDirections')}</a>
        ) : (
          <a href={directionsUrl} class="btn btn--secondary" target="_blank" rel="noopener">
            Get Directions
          </a>
        )
      )}
    </div>
  )}
</aside>
