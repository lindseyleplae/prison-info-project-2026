---
import { buildBreadcrumbs } from '../lib/breadcrumbs';
import { t, type Lang } from '../lib/ui-strings';

const { pageTitle, stateLabel, lang = 'en' } = Astro.props as {
  pageTitle?: string;
  stateLabel?: string;
  lang?: Lang;
};
const items = buildBreadcrumbs({
  pathname: Astro.url.pathname,
  pageTitle,
  stateLabel,
  lang
});
---

{
  items.length > 1 && (
    <nav class="breadcrumbs" aria-label={t(lang, 'crumb.breadcrumbLabel')}>
      <ol>
        {items.map((item, index) => (
          <li>
            {item.href ? (
              <a href={item.href} aria-current={index === items.length - 1 ? 'page' : undefined}>
                {item.label}
              </a>
            ) : (
              <span aria-current={index === items.length - 1 ? 'page' : undefined}>{item.label}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
