---
// The Prison Visitor Guide mark: an open book (a guide/reference) with a gold
// bookmark. Book strokes use `currentColor` so the mark inherits its color from
// context — slate in the light header, light on the dark footer — with no
// variant flag needed. The bookmark is the fixed gold accent. Decorative:
// aria-hidden, since the adjacent wordmark carries the accessible name.
interface Props {
  size?: number | string;
  class?: string;
}
const { size = 30, class: className } = Astro.props;
---

<svg
  class:list={['brand-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M24 16 Q14.5 12 7 15 L7 32.5 Q14.5 29.5 24 32.5 Z"
    stroke="currentColor"
    stroke-width="2.1"
    stroke-linejoin="round"
  ></path>
  <path
    d="M24 16 Q33.5 12 41 15 L41 32.5 Q33.5 29.5 24 32.5 Z"
    stroke="currentColor"
    stroke-width="2.1"
    stroke-linejoin="round"
  ></path>
  <line x1="24" y1="16" x2="24" y2="32.5" stroke="currentColor" stroke-width="2.1"></line>
  <line x1="11" y1="20.6" x2="19.5" y2="21.9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.5"></line>
  <line x1="11" y1="24.2" x2="19.5" y2="25.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.5"></line>
  <path d="M28.6 13 L28.6 22.4 L31 20.1 L33.4 22.4 L33.4 12.7" fill="var(--color-gold)"></path>
</svg>
