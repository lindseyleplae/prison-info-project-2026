---
// Site header dispatcher. English and Spanish headers live in their own
// top-level components (HeaderEn / HeaderEs) so Astro preserves each one's
// exact inter-tag whitespace — this is what keeps English pages byte-identical
// while Spanish pages get localized labels and /es links. The shared menu
// <script> lives here so it renders once regardless of language.
import HeaderEn from './HeaderEn.astro';
import HeaderEs from './HeaderEs.astro';
import type { Lang } from '../lib/ui-strings';

const { lang = 'en', enPath = '/', esPath = '/es/', hasSpanish = false } = Astro.props as {
  lang?: Lang;
  enPath?: string;
  esPath?: string;
  hasSpanish?: boolean;
};
---

{lang === 'es' ? (
  <HeaderEs enPath={enPath} esPath={esPath} hasSpanish={hasSpanish} />
) : (
  <HeaderEn enPath={enPath} esPath={esPath} hasSpanish={hasSpanish} />
)}{' '}

<script is:inline>
  const toggle = document.querySelector('.mobile-menu-toggle');
  const nav = document.querySelector('#primary-nav');
  const submenuToggles = Array.from(document.querySelectorAll('[data-submenu-toggle]'));
  const mobileNav = window.matchMedia('(max-width: 63.99rem)');

  let scrollAnchor = 0;

  const setSubmenuIcon = (button) => {
    const icon = button.querySelector('[aria-hidden="true"]');
    if (icon) {
      icon.textContent = button.getAttribute('aria-expanded') === 'true' ? '−' : '+';
    }
  };

  const closeSubmenus = () => {
    submenuToggles.forEach((button) => {
      button.setAttribute('aria-expanded', 'false');
      button.closest('[data-nav-group]')?.removeAttribute('data-open');
      setSubmenuIcon(button);
    });
  };

  const closeMainMenu = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    closeSubmenus();
  };

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      if (isExpanded) {
        closeSubmenus();
      } else {
        scrollAnchor = window.scrollY;
      }
    });
  }

  submenuToggles.forEach((button) => {
    button.addEventListener('click', (event) => {
      if (!mobileNav.matches) {
        return;
      }

      event.preventDefault();
      const group = button.closest('[data-nav-group]');
      const wasExpanded = button.getAttribute('aria-expanded') === 'true';

      closeSubmenus();

      if (!wasExpanded && group) {
        button.setAttribute('aria-expanded', 'true');
        group.setAttribute('data-open', 'true');
        setSubmenuIcon(button);
      }
    });
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) {
      return;
    }

    if (!nav?.contains(event.target) && !toggle?.contains(event.target)) {
      closeMainMenu();
    }
  });

  window.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') {
      return;
    }
    closeMainMenu();
  });

  // Close the menu when the user scrolls more than ~40px from where it was
  // opened. Small allowance prevents the menu from snapping closed due to
  // layout shift on open.
  window.addEventListener(
    'scroll',
    () => {
      if (toggle?.getAttribute('aria-expanded') !== 'true') {
        return;
      }
      if (Math.abs(window.scrollY - scrollAnchor) > 40) {
        closeMainMenu();
      }
    },
    { passive: true }
  );

  mobileNav.addEventListener('change', (event) => {
    if (!event.matches) {
      closeMainMenu();
    }
  });
</script>
