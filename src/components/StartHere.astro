---
// "Start here" dispatcher for the crisis entry point. English and Spanish
// versions live in their own top-level components (StartHereEn / StartHereEs) so
// Astro preserves each one's exact whitespace — keeping English state pages
// byte-identical while Spanish pages get translated steps and /es links.
import StartHereEn from './StartHereEn.astro';
import StartHereEs from './StartHereEs.astro';
import type { Lang } from '../lib/ui-strings';

const { system, stateSlug, locatorUrl, lang = 'en' } = Astro.props as {
  system: string;
  stateSlug: string;
  locatorUrl: string;
  lang?: Lang;
};
---

{lang === 'es' ? (
  <StartHereEs system={system} stateSlug={stateSlug} locatorUrl={locatorUrl} />
) : (
  <StartHereEn system={system} stateSlug={stateSlug} locatorUrl={locatorUrl} />
)}
